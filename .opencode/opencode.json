{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "ecc"
  ],
  "instructions": [
    ".opencode/AGENTS.agent-skills.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8787"
      }
    },
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "timeout": 10000
    }
  }
}
